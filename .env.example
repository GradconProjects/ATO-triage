# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Production URL, used in emails and absolute links
APP_BASE_URL=http://localhost:3000
REPORT_TIMEZONE=Australia/Melbourne
# Team sign-in (username + code). Comma separated: username:code:Display Name:restriction_level
# Levels: full | standard | restricted | view_only. Codes never live in the repository.
TEAM_SEED_USERS=
# Server-side pepper mixed into team codes before they are used as auth passwords. Set a long random value.
APP_PIN_PEPPER=
# Extra admin emails (no restriction), comma separated. ipaliboboma@gmail.com is always an admin.
ADMIN_EMAILS=
